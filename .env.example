# ==========================================
# 11 11 LUXURY E-COMMERCE CONFIGURATION
# ==========================================

# Database Configuration (PostgreSQL)
# DATABASE_URL="postgresql://eleven_user:eleven_password@localhost:5432/eleven11_db?schema=public"
DATABASE_URL="postgresql://postgres:postgres%40123@localhost:5432/fashion_store"

# Redis & BullMQ
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Secrets
JWT_SECRET=eleven11_super_secret_jwt_access_key_change_in_production
JWT_REFRESH_SECRET=eleven11_super_secret_jwt_refresh_key_change_in_production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# DigitalOcean Spaces (S3 Compatible Storage)
SPACES_ENDPOINT=https://nyc3.digitaloceanspaces.com
SPACES_REGION=nyc3
SPACES_BUCKET=eleven11-media
SPACES_ACCESS_KEY_ID=your_spaces_key
SPACES_SECRET_ACCESS_KEY=your_spaces_secret
SPACES_CDN_URL=https://eleven11-media.nyc3.cdn.digitaloceanspaces.com

# Payment Gateways (Razorpay / Cashfree)
RAZORPAY_KEY_ID=rzp_test_exampleKey123
RAZORPAY_KEY_SECRET=rzp_test_secretKey456
RAZORPAY_WEBHOOK_SECRET=webhook_secret_789

# Mailer (Mailpit locally, SMTP/SendGrid in production)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
MAIL_FROM="11 11 Concierge <concierge@eleven11atelier.com>"

# App Ports & URLs
API_PORT=4000
API_URL=http://localhost:4000
STOREFRONT_PORT=3000
STOREFRONT_URL=http://localhost:3000
ADMIN_PORT=3001
ADMIN_URL=http://localhost:3001
