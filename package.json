{
  "name": "11-11-ecommerce-monorepo",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@9.2.0",
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "db:generate": "pnpm --filter @11-11/database generate",
    "db:push": "pnpm --filter @11-11/database push",
    "db:seed": "pnpm --filter @11-11/database seed",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\""
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "turbo": "^2.1.3",
    "typescript": "^5.6.3"
  }
}
